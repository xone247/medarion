<style type="text/css" id="wp-custom-css">*{
  font-family:noto sans;
}
/* adjust single post margins 24838563-hc */
.single .site-content {
    margin-left: 20%;
    margin-right: 20%;
}
/* on pages, hide image and description used for preview. They still show and are used on blog posts */
.type-page .post-thumb-img-content, .type-page .entry-header {
	display: none;
}

/* center featured image on blog posts */
.single-post  .post-thumb-img-content {
   text-align: center;
}

/* lower all content below nav bar on blog post pages,  on author archive pages and search results */
.search .site-content, .author .site-content, .single-post  .site-content {
   padding-top: 65px;
}


/* fix nav on blog posts to have background instead of being invisible */
.single-post .main-header-bar {
	background-color: rgba(56,70,77,0.6);
}
/* fix nav text on blog posts to be white */
.single-post .main-header-bar .main-header-menu .menu-link {
	color: #ffffff;
}



@media only screen and (max-width: 544px) {
	/* fix h1s only on mobile to be smaller so they don't wrap mid word */
  h1, .entry-content h1 {
    font-size: 40px !important;
    word-wrap: normal !important;
  }
	
	/* fix posts to be much wider */
	.single .site-content {
    margin-left: 1%;
    margin-right: 1%;
 }
}


/* on just partnerships, force font to be correct size  */
#post-3021  h1, #post-3021  .entry-content h1 {
    font-size: 59px;
}
.type-page .logo-svg-phone-icons svg .st0 {
    fill: #278489;
}</style>		<!-- Jetpack Google Analytics -->
