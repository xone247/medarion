.cli-tab-footer .wt-cli-privacy-accept-btn {
    background-color: #000000;
    text-transform: capitalize;
}

/*popup style*/
.pum-content.popmake-content {
    padding: 15px;
    margin: -20px 0 -20px 0;
}
/*popup style end*/

@media (max-width: 980px) {
    .hide-mobile{
    display: none !important;
    }
}

#header-outer header .nectar-menu-icon-img {
    margin-top: 3px;
}

sup {
    vertical-align: top; position: relative; top: -0.5em;
}

sub {
    vertical-align: bottom; position: relative; top: 0.8em;
}

h1.entry-title {
    font-size: 40px !important;
    line-height: 48px !important;
    max-width: 700px !important;
}

.gform_wrapper .field_description_below .gfield_consent_description, .gform_wrapper .gfield_consent_description {
    border: none;
    margin-top: 5px;
    font-size: 14px;
}

.gform_wrapper .gform_page_footer .button.gform_previous_button, .button.gform_next_button {
    padding: 15px 20px;
}

.page-submenu ul {
    border-bottom: 1px solid #ECF1FA;
}

body .page-submenu li a {
    font-size: 14px !important;
}

div#copyright.row p {
    font-size:13px;
}

p#breadcrumbs a {
    text-decoration: underline;
}

p#breadcrumbs {
    font-size: 13px;
}

body .page-submenu li a {
    font-size: 16px;
}

input#gform_submit_button_2 {
    height: 48px;
    margin: 12px 0 0 10px;
}

figcaption {
    font-size: 12px;
    font-style: italic;
}

body:not([data-header-format="left-header"]) #top nav >ul >.megamenu >ul >li >a {
    letter-spacing:0.5px;
}

.woocommerce div.product .woocommerce-tabs ul.tabs {
    display: none;
}

button[type=submit], input[type=button], input[type=submit] {
    font-family: Inter!important;
}

.footer-group {
    width: 100%;
    align-items: flex-start;
    column-gap: 0!important;
    row-gap: 32px!important
}

.footer-col {
    flex: 1 0 16.66%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 10px;
}

.footer-col p {
    text-align: left;
}

.footer-copyright {
    font-size: 13px;
    color: #212121;
}

.has-text-align-left {
    text-align: left;
}

.material #footer-outer #footer-widgets .col ul .wp-social-link {
    padding: 0!important;
}


@media only screen and (max-width: 1180px) {
    .footer-group {
        flex-wrap: wrap!important;
    }
    
    .footer-col {
        flex-basis: 33.33%;
    }
}

@media only screen and (max-width: 850px) {
    .footer-bottom {
        margin-bottom: 30px!important;
        flex-wrap: wrap!important;
        flex-direction: column-reverse!important;
        align-items: flex-start!important;
        row-gap: 15px!important;
    }
    .footer-bottom .wp-block-column {
        flex-basis: 100%!important;
    }
}

@media only screen and (max-width: 690px) {
    .footer-col {
        flex-basis: 100%;
    }
}

@media only screen and (min-width: 1201px) {
    .menu-item-hide-text-desktop > a > .menu-title-text {
        display: none!important;
    }
}
